<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} · Streamzone</title>
  <style>
    :root { color-scheme: dark; font-family: system-ui, sans-serif; background: #090b14; color: #f4f5ff; }
    body { margin: 0; } header, main { max-width: 68rem; margin: auto; padding: 1.25rem; }
    header { display: flex; align-items: center; justify-content: space-between; } nav { display: flex; gap: .8rem; align-items: center; }
    a { color: #9ed0ff; } .brand { color: white; font-size: 1.35rem; font-weight: 800; text-decoration: none; }
    .hero { padding: 4rem 0 2rem; } h1 { font-size: clamp(2.2rem, 8vw, 5rem); line-height: .95; margin: 0 0 1rem; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1rem; }
    .card, form.panel { background: #15192a; border: 1px solid #2a3150; border-radius: 1rem; padding: 1.25rem; }
    form.panel { max-width: 28rem; margin: 3rem auto; } label { display: block; margin: 1rem 0; }
    input, select { box-sizing: border-box; width: 100%; margin-top: .4rem; padding: .75rem; color: white; background: #090b14; border: 1px solid #465071; border-radius: .5rem; }
    button, .button { border: 0; border-radius: .5rem; padding: .7rem 1rem; background: #795cff; color: white; font-weight: 700; cursor: pointer; text-decoration: none; }
    .error { padding: .75rem; background: #55202b; border-radius: .5rem; } .muted { color: #adb5d1; } table { width: 100%; border-collapse: collapse; } th, td { padding: .75rem; text-align: left; border-bottom: 1px solid #2a3150; }
  </style>
</head>
<body>
  <header>
    <a class="brand" href="/">STREAMZONE</a>
    <nav>
      {{#if user}}
        <a href="/dashboard">Dashboard</a>
        <form method="post" action="/logout"><button type="submit">Sign out</button></form>
      {{else}}
        <a href="/login">Sign in</a><a class="button" href="/register">Get started</a>
      {{/if}}
    </nav>
  </header>
  <main>{{{content}}}</main>
</body>
</html>

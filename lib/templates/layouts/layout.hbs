<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>{{title}} · Streamzone</title>
  <link rel="stylesheet" href="/assets/styles/streamzone.css">
  <link rel="stylesheet" href="/assets/styles/command-management.css">
  {{#if pageStylesheet}}<link rel="stylesheet" href="{{pageStylesheet}}">{{/if}}
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="brand" href="/" aria-label="Streamzone home"><span aria-hidden="true">◈</span> STREAMZONE</a>
      <nav class="site-nav" aria-label="Primary navigation">
        {{#if user}}
          <a href="/dashboard">Dashboard</a>
          <form class="inline-form" method="post" action="/logout"><button class="button button--quiet" type="submit">Sign out</button></form>
        {{else}}
          <a href="/login">Sign in</a><a class="button" href="/register">Get started</a>
        {{/if}}
      </nav>
    </div>
  </header>
  <main id="main-content" class="site-main">{{{content}}}</main>
</body>
</html>

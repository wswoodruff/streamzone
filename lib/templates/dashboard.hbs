{{#if currentStreamer}}
<div class="management-shell">
  <aside class="management-sidebar" aria-label="Current creator workspace">
    <div class="workspace-identity">
      <span class="eyebrow">Current creator</span>
      <strong>{{currentStreamer.displayName}}</strong>
      <span class="muted">@{{currentStreamer.slug}}</span>
      <span class="role-badge">{{currentStreamer.roleLabel}} access</span>
    </div>
    {{> management-nav}}
    <div class="sidebar-account">
      <span class="eyebrow">Signed in</span>
      <span>{{user.displayName}}</span>
    </div>
  </aside>

  <div class="management-content">
    {{> management-feedback}}
    <section class="dashboard-hero" id="overview" aria-labelledby="dashboard-title">
      <div>
        <p class="eyebrow">Creator control room</p>
        <h1 id="dashboard-title">{{currentStreamer.displayName}}</h1>
        <p class="lede">A live view of this creator's Streamzone setup, session state, audience economy, and management capabilities.</p>
      </div>
      <form class="streamer-switcher" method="get" action="/dashboard">
        <label for="streamerId">Creator workspace</label>
        <div class="inline-control">
          <select id="streamerId" name="streamerId">
            {{#each streamers}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{displayName}} (@{{slug}})</option>
            {{/each}}
          </select>
          <button class="button button--secondary" type="submit">Switch</button>
        </div>
      </form>
    </section>

    <div class="metric-grid" aria-label="Workspace summary">
      <a class="metric-card" href="{{links.stream}}">
        <span class="metric-card__label">Stream state</span>
        {{#if currentSession}}
          <strong>{{currentSession.statusLabel}}</strong>
          <span>{{currentSession.contextLabel}}</span>
        {{else}}
          <strong>No session</strong>
          <span>Nothing scheduled yet</span>
        {{/if}}
      </a>
      <a class="metric-card" href="{{links.sources}}">
        <span class="metric-card__label">Sources</span>
        <strong>{{currentStreamer.enabledSourceCount}} / {{currentStreamer.sourceCount}}</strong>
        <span>enabled providers</span>
      </a>
      <a class="metric-card" href="{{links.commands}}">
        <span class="metric-card__label">Commands</span>
        <strong>{{commands.enabled}} / {{commands.total}}</strong>
        <span>enabled commands</span>
      </a>
      <a class="metric-card" href="{{links.ai}}">
        <span class="metric-card__label">Standalone AI</span>
        <strong>{{ai.statusLabel}}</strong>
        <span>{{#if ai.configured}}{{ai.commandLabel}}{{else}}Channel capability{{/if}}</span>
      </a>
    </div>

    <section class="management-section" id="stream" aria-labelledby="stream-heading">
      <div class="section-heading">
        <div><p class="eyebrow">Runtime</p><h2 id="stream-heading">Stream session</h2></div>
        {{#if permissions.manageStreams}}<span class="capability capability--manage">Can manage</span>{{else}}<span class="capability">Read only</span>{{/if}}
      </div>
      {{#if currentSession}}
        <article class="panel status-panel">
          <div class="status-panel__main">
            <div class="status-line"><span class="status-dot status-dot--{{currentSession.statusTone}}" aria-hidden="true"></span><span class="status-pill status-pill--{{currentSession.statusTone}}">{{currentSession.statusLabel}}</span></div>
            <h3>{{currentSession.title}}</h3>
            <p class="muted">{{currentSession.timingLabel}}</p>
          </div>
          <dl class="detail-list">
            <div><dt>Context</dt><dd>{{currentSession.contextLabel}}</dd></div>
            <div><dt>Broadcasts</dt><dd>{{currentSession.streamCountLabel}}</dd></div>
            <div><dt>Providers</dt><dd>{{#if currentSession.hasProviders}}{{#each currentSession.providers}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}None attached{{/if}}</dd></div>
          </dl>
        </article>
      {{else}}
        {{> empty-state title="No StreamSession yet" body="Schedule or start a Streamzone session and its runtime state will appear here."}}
      {{/if}}
    </section>

    <section class="management-section" id="sources" aria-labelledby="sources-heading">
      <div class="section-heading"><div><p class="eyebrow">Providers</p><h2 id="sources-heading">Sources</h2></div>{{#if permissions.manageSources}}<span class="capability capability--manage">Can manage</span>{{else}}<span class="capability">Read only</span>{{/if}}</div>
      {{#if sources.length}}
        <div class="compact-grid">
          {{#each sources}}
            <article class="panel source-card"><div class="panel-title-row"><h3>{{providerName}}</h3><span class="status-pill {{#if enabled}}status-pill--live{{else}}status-pill--neutral{{/if}}">{{statusLabel}}</span></div><p class="muted mono">{{channelId}}</p></article>
          {{/each}}
        </div>
      {{else}}
        {{> empty-state title="No provider sources configured" body="Connect a Twitch or YouTube source before Streamzone can associate provider broadcasts with this creator."}}
      {{/if}}
    </section>

    <section class="management-section" id="commands" aria-labelledby="commands-heading">
      <div class="section-heading"><div><p class="eyebrow">Interaction</p><h2 id="commands-heading">Commands</h2></div>{{#if permissions.manageCommands}}<span class="capability capability--manage">Can manage</span>{{else}}<span class="capability">Read only</span>{{/if}}</div>
      {{#if commands.total}}
        <article class="panel">
          <div class="summary-row"><span><strong>{{commands.enabled}}</strong> enabled</span><span><strong>{{commands.disabled}}</strong> disabled</span></div>
          <ul class="item-list">
            {{#each commands.items}}
              <li><div><strong class="mono">!{{name}}</strong><span class="muted">{{roleLabel}} · {{cooldownLabel}}</span></div><span class="status-pill {{#if enabled}}status-pill--live{{else}}status-pill--neutral{{/if}}">{{statusLabel}}</span></li>
            {{/each}}
          </ul>
          {{#if commands.hiddenCount}}<p class="panel-footnote">+ {{commands.hiddenCount}} more configured commands</p>{{/if}}
        </article>
      {{else}}
        {{> empty-state title="No commands configured" body="This creator has no deterministic chat commands yet. Command forms can plug into this section in the next management increment."}}
      {{/if}}
    </section>

    {{> team-management}}
    {{> rewards-management}}
    {{> ai-management}}
  </div>
</div>
{{else}}
<section class="empty-workspace" aria-labelledby="empty-workspace-title">
  <p class="eyebrow">Creator control room</p>
  <h1 id="empty-workspace-title">No creator workspace yet</h1>
  <p>Your account is signed in, but it is not a member of any Streamzone creator workspace. Once a streamer membership is provisioned, its management dashboard will appear here.</p>
  <a class="button button--secondary" href="/">Return to Streamzone</a>
</section>
{{/if}}

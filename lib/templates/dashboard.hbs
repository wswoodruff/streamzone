<section class="hero"><p class="muted">CREATOR CONTROL ROOM</p><h1>Hello, {{user.displayName}}.</h1></section>
<section><h2>Hosted creators</h2><div class="grid">{{#each streamers}}<article class="card"><h3>{{displayName}}</h3><p class="muted">@{{slug}} · {{sources.length}} sources</p></article>{{else}}<article class="card">No creators configured yet.</article>{{/each}}</div></section>
<section><h2>Broadcasts</h2><div class="card"><table><thead><tr><th>Title</th><th>Provider</th><th>Status</th></tr></thead><tbody>{{#each streams}}<tr><td>{{title}}</td><td>{{source.provider}}</td><td>{{status}}</td></tr>{{else}}<tr><td colspan="3">No broadcasts tracked yet.</td></tr>{{/each}}</tbody></table></div></section>

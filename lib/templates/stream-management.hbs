{{#if currentStreamer}}
<div class="management-shell">
  <aside class="management-sidebar" aria-label="Current creator workspace">
    <div class="workspace-identity">
      <span class="eyebrow">Current creator</span>
      <strong>{{currentStreamer.displayName}}</strong>
      <span class="muted">@{{currentStreamer.slug}}</span>
      <span class="role-badge">{{currentStreamer.roleLabel}} access</span>
    </div>
    {{> management-nav}}
    <div class="sidebar-account">
      <span class="eyebrow">Signed in</span>
      <span>{{user.displayName}}</span>
    </div>
  </aside>

  <div class="management-content">
    <section class="dashboard-hero" aria-labelledby="stream-management-title">
      <div>
        <p class="eyebrow">Live operations</p>
        <h1 id="stream-management-title">Streams &amp; sources</h1>
        <p class="lede">Manage streaming channels, plan show sessions, and keep each Twitch or YouTube broadcast grouped with the show it belongs to.</p>
      </div>
      <form class="streamer-switcher" method="get" action="/dashboard/stream-management">
        <label for="streamerId">Creator workspace</label>
        <div class="inline-control">
          <select id="streamerId" name="streamerId">
            {{#each streamers}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{displayName}} (@{{slug}})</option>
            {{/each}}
          </select>
          <button class="button button--secondary" type="submit">Switch</button>
        </div>
      </form>
    </section>

    {{#if notice}}<p class="panel status-pill--live" role="status">{{notice}}</p>{{/if}}
    {{#if error}}<p class="error" role="alert">{{error}}</p>{{/if}}

    <article class="panel">
      <div class="panel-title-row"><h2>How live broadcasts are organized</h2><span class="capability">Cross-platform</span></div>
      <div class="split-grid">
        <div>
          <p class="eyebrow">Show session</p>
          <h3>One show across platforms</h3>
          <p class="muted">A session tracks one Streamzone show from scheduled through live to ended. Simulcasts can group several platform broadcasts into the same session.</p>
        </div>
        <div>
          <p class="eyebrow">Platform broadcast</p>
          <h3>One broadcast on one channel</h3>
          <p class="muted">Each Twitch or YouTube broadcast belongs to a streaming source and one show session, so its status stays tied to the right event.</p>
        </div>
      </div>
    </article>

    <section class="management-section" id="sessions" aria-labelledby="sessions-heading">
      <div class="section-heading">
        <div><p class="eyebrow">Shows</p><h2 id="sessions-heading">Sessions</h2></div>
        {{#if permissions.manageStreams}}<span class="capability capability--manage">Can manage</span>{{else}}<span class="capability">Read only</span>{{/if}}
      </div>

      {{#if permissions.manageStreams}}
        <article class="panel">
          <h3>Create a session</h3>
          <p class="muted">Create the show session first, then attach each platform broadcast to it.</p>
          <form method="post" action="/dashboard/stream-management/sessions">
            <input type="hidden" name="streamerId" value="{{currentStreamer.id}}">
            <label for="session-title">Session title
              <input id="session-title" name="title" maxlength="255" required placeholder="Friday community stream">
            </label>
            <label for="scheduled-at">Scheduled time (UTC, optional)
              <input id="scheduled-at" type="datetime-local" name="scheduledAt">
            </label>
            <button type="submit">Create session</button>
          </form>
        </article>
      {{/if}}

      {{#if sessions.length}}
        <article class="panel">
          <ul class="item-list">
            {{#each sessions}}
              <li>
                <div>
                  <strong>{{title}}</strong>
                  <span class="muted">{{timingLabel}} · {{streamCountLabel}} · Session #{{id}}</span>
                </div>
                <div>
                  <span class="status-pill status-pill--{{statusTone}}">{{statusLabel}}</span>
                  {{#if canStart}}
                    <form class="inline-form" method="post" action="/dashboard/stream-management/sessions/{{id}}/lifecycle">
                      <input type="hidden" name="streamerId" value="{{../currentStreamer.id}}">
                      <input type="hidden" name="action" value="start">
                      <button class="button button--quiet" type="submit">Start session</button>
                    </form>
                  {{/if}}
                  {{#if canEnd}}
                    <form class="inline-form" method="post" action="/dashboard/stream-management/sessions/{{id}}/lifecycle">
                      <input type="hidden" name="streamerId" value="{{../currentStreamer.id}}">
                      <input type="hidden" name="action" value="end">
                      <button class="button button--quiet" type="submit">End session</button>
                    </form>
                  {{/if}}
                </div>
              </li>
            {{/each}}
          </ul>
        </article>
      {{else}}
        {{> empty-state title="No sessions yet" body="Create a show session before attaching platform broadcasts."}}
      {{/if}}
    </section>

    <section class="management-section" id="sources" aria-labelledby="sources-heading">
      <div class="section-heading">
        <div><p class="eyebrow">Streaming channels</p><h2 id="sources-heading">Sources</h2></div>
        {{#if permissions.manageSources}}<span class="capability capability--manage">Can manage</span>{{else}}<span class="capability">Read only</span>{{/if}}
      </div>

      {{#if permissions.manageSources}}
        <article class="panel">
          <h3>YouTube</h3>
          <p class="muted">Authorize YouTube to verify your channel and discover broadcasts. Streamzone never stores raw provider responses.</p>
          {{#if hasYouTubeConnection}}
            {{#each youtubeConnections}}
              <p><strong>Verified channel: {{channelName}}</strong> <span class="muted mono">{{channelId}}</span></p>
              {{#if reconnect}}<a class="button" href="/streamers/{{../currentStreamer.id}}/provider-connections/youtube/start">Reconnect</a>{{else}}<a class="button button--secondary" href="/streamers/{{../currentStreamer.id}}/provider-connections/youtube/start">Reconnect</a>{{/if}}
              <form class="inline-form" method="post" action="/streamers/{{../currentStreamer.id}}/provider-connections/{{id}}/disconnect"><button class="button button--quiet" type="submit">Disconnect</button></form>
            {{/each}}
          {{else}}<a class="button" href="/streamers/{{currentStreamer.id}}/provider-connections/youtube/start">Connect YouTube</a>{{/if}}
          <details>
          <summary>Advanced: Add a source manually</summary>
          <p class="muted">Manual provider identifiers are intended for development and troubleshooting.</p>
          <form method="post" action="/dashboard/stream-management/sources">
            <input type="hidden" name="streamerId" value="{{currentStreamer.id}}">
            <label for="source-provider">Provider
              <select id="source-provider" name="provider" required>
                <option value="twitch">Twitch</option>
                <option value="youtube">YouTube</option>
              </select>
            </label>
            <label for="source-channel-id">Provider channel ID
              <input id="source-channel-id" name="channelId" maxlength="255" required placeholder="channel-id-from-provider">
            </label>
            <button type="submit">Add source</button>
          </form>
          </details>
        </article>
      {{/if}}

      {{#if sources.length}}
        <div class="compact-grid">
          {{#each sources}}
            <article class="panel source-card">
              <div class="panel-title-row"><h3>{{providerName}}</h3><span class="status-pill {{#if enabled}}status-pill--live{{else}}status-pill--neutral{{/if}}">{{statusLabel}}</span></div>
              <p class="muted mono">{{channelId}}</p>
              <dl class="detail-list">
                <div><dt>Broadcasts</dt><dd>{{streamCount}}</dd></div>
                <div><dt>Latest broadcast</dt><dd>{{latestBroadcastLabel}}</dd></div>
              </dl>
            </article>
          {{/each}}
        </div>
      {{else}}
        {{> empty-state title="No streaming sources configured" body="Add a Twitch or YouTube channel before attaching a platform broadcast."}}
      {{/if}}
    </section>

    <section class="management-section" id="broadcasts" aria-labelledby="broadcasts-heading">
      <div class="section-heading">
        <div><p class="eyebrow">Platforms</p><h2 id="broadcasts-heading">Broadcasts</h2></div>
        {{#if permissions.manageStreams}}<span class="capability capability--manage">Can manage</span>{{else}}<span class="capability">Read only</span>{{/if}}
      </div>

      {{#if permissions.manageStreams}}
        {{#each youtubeConnections}}
          {{#if active}}
          <article class="panel" data-youtube-picker>
            <h3>Select a verified YouTube broadcast</h3>
            <p class="muted">Only upcoming and currently live broadcasts available to this grant are shown.</p>
            <form method="post" action="/streamers/{{../currentStreamer.id}}/provider-connections/{{id}}/youtube/broadcasts/select">
              <label>Broadcast
                <select name="broadcastId" required data-broadcast-options data-discovery-url="/streamers/{{../currentStreamer.id}}/provider-connections/{{id}}/youtube/broadcasts"><option value="">Loading broadcasts…</option></select>
              </label>
              <label>Existing session<select name="streamSessionId"><option value="">Create a new session</option>{{#each ../sessionOptions}}<option value="{{id}}">{{optionLabel}}</option>{{/each}}</select></label>
              <label>New session title<input name="newSessionTitle" maxlength="255" placeholder="Defaults only when creating a session"></label>
              <button type="submit">Connect broadcast</button>
            </form>
          </article>
          {{/if}}
        {{/each}}
        {{#if canAttachBroadcast}}
          <article class="panel">
            <h3>Attach a platform broadcast</h3>
            <p class="muted">Choose the streaming source and show session this broadcast belongs to.</p>
            <form method="post" action="/dashboard/stream-management/streams">
              <input type="hidden" name="streamerId" value="{{currentStreamer.id}}">
              <label for="broadcast-source">Source
                <select id="broadcast-source" name="sourceId" required>
                  {{#each sourceOptions}}<option value="{{id}}">{{optionLabel}}</option>{{/each}}
                </select>
              </label>
              <label for="broadcast-session">Session
                <select id="broadcast-session" name="streamSessionId" required>
                  {{#each sessionOptions}}<option value="{{id}}">{{optionLabel}}</option>{{/each}}
                </select>
              </label>
              <label for="broadcast-title">Broadcast title (optional)
                <input id="broadcast-title" name="title" maxlength="255" placeholder="Platform title">
              </label>
              <label for="broadcast-external-id">Platform broadcast ID (optional)
                <input id="broadcast-external-id" name="externalId" maxlength="255" placeholder="video-id-or-broadcast-id">
              </label>
              <label for="broadcast-status">State
                <select id="broadcast-status" name="status">
                  <option value="scheduled">Scheduled</option>
                  <option value="live">Live</option>
                  <option value="offline">Offline</option>
                </select>
              </label>
              <button type="submit">Attach broadcast</button>
            </form>
          </article>
        {{else}}
          {{> empty-state title="Create the prerequisites first" body="An enabled source and a non-ended session are required before a platform broadcast can be attached."}}
        {{/if}}
      {{/if}}

      {{#if streams.length}}
        <article class="panel">
          <ul class="item-list">
            {{#each streams}}
              <li>
                <div>
                  <strong>{{title}}</strong>
                  <span class="muted">{{sourceProviderName}} · {{sourceChannelId}}</span>
                  <span class="muted">Session: {{streamSessionTitle}} (#{{streamSessionId}}) · {{externalIdLabel}}</span>
                  <span class="muted">{{timingLabel}}</span>
                </div>
                <span class="status-pill status-pill--{{statusTone}}">{{statusLabel}}</span>
              </li>
            {{/each}}
          </ul>
        </article>
      {{else}}
        {{> empty-state title="No platform broadcasts attached" body="Broadcasts will appear here once they are attached to a streaming source and show session."}}
      {{/if}}
    </section>
  </div>
</div>
{{else}}
<section class="empty-workspace" aria-labelledby="empty-stream-management-title">
  <p class="eyebrow">Live operations</p>
  <h1 id="empty-stream-management-title">No creator workspace yet</h1>
  <p>Your account is signed in, but it is not a member of any Streamzone creator workspace.</p>
  <a class="button button--secondary" href="/dashboard">Return to dashboard</a>
</section>
{{/if}}
<script>
document.querySelectorAll('[data-broadcast-options]').forEach(async (select) => {
  try { const response = await fetch(select.dataset.discoveryUrl); const body = await response.json(); if (!response.ok) throw new Error(body.message); select.innerHTML = body.broadcasts.length ? body.broadcasts.map((item) => `<option value="${item.id}">${item.title} · ${item.status}</option>`).join('') : '<option value="">No upcoming or active broadcasts</option>'; }
  catch (error) { select.innerHTML = `<option value="">${error.message || 'Unable to load broadcasts'}</option>`; select.closest('article').setAttribute('data-discovery-error', 'true'); }
});
</script>

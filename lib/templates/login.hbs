<form class="panel" method="post" action="/login{{#if next}}?next={{next}}{{/if}}">
  <h1>Welcome back</h1>
  {{#if error}}<p class="error">{{error}}</p>{{/if}}
  <label>Email <input type="email" name="email" value="{{email}}" required autocomplete="email"></label>
  <label>Password <input type="password" name="password" required autocomplete="current-password"></label>
  <button type="submit">Sign in</button>
  <p class="muted">New here? <a href="/register">Create an account</a>.</p>
</form>

{
  "name": "streamzone",
  "version": "1.0.0",
  "private": true,
  "description": "A multi-streamer platform for interactive livestream chat experiences.",
  "main": "lib/index.js",
  "scripts": {
    "start": "node server.js",
    "dev:seed": "node tools/dev-seed.js",
    "console": "node tools/test-console/client.js",
    "console:host": "node tools/test-console/host.js",
    "test": "NODE_ENV=test node --test",
    "test:syntax": "find . -path ./node_modules -prune -o -name '*.js' -type f -print0 | xargs -0 -n1 node --check",
    "test:e2e": "playwright test e2e/dashboard.spec.js",
    "ui:capture": "playwright test e2e/dashboard.capture.spec.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hapi/cookie": "^12.0.1",
    "@hapi/hapi": "^21.4.3",
    "@hapi/inert": "^7.1.2",
    "@hapi/joi": "^17.1.1",
    "@hapi/vision": "^7.0.3",
    "@hapipal/haute-couture": "^4.0.0",
    "@hapipal/schmervice": "^3.0.0",
    "@hapipal/schwifty": "^6.2.0",
    "better-sqlite3": "^12.2.0",
    "enquirer": "^2.4.1",
    "handlebars": "^4.7.8",
    "knex": "^3.1.0",
    "objection": "^3.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
